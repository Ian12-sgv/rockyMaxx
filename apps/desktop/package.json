{
  "name": "@sistema-arabe/desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Aplicacion de escritorio Rocky Maxx con backend embebido.",
  "author": "OpenAI Codex",
  "main": "main.js",
  "scripts": {
    "start": "node start-electron.js",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "41.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rockymaxx.desktop",
    "productName": "Rocky Maxx",
    "executableName": "RockyMaxx",
    "electronVersion": "41.2.1",
    "asar": true,
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "main.js",
      "start-electron.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".bundle/api",
        "to": "api"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true
    }
  }
}
