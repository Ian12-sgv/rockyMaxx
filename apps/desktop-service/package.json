{
    "name":  "@sistema-arabe/desktop-service",
    "version":  "2.1.7",
    "private":  true,
    "description":  "Servicio local Rocky Maxx para la PC principal.",
    "author":  "OpenAI Codex",
    "main":  "main.js",
    "scripts":  {
                    "start":  "node start-electron.js",
                    "dist:win":  "electron-builder --win nsis"
                },
    "devDependencies":  {
                            "electron":  "41.2.1",
                            "electron-builder":  "^26.0.12"
                        },
    "build":  {
                  "appId":  "com.rockymaxx.localservice",
                  "productName":  "Rocky Maxx Servicio Local",
                  "executableName":  "RockyMaxxServicioLocal",
                  "electronVersion":  "41.2.1",
                  "asar":  true,
                  "directories":  {
                                      "output":  "../../dist/desktop-service"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "config.html",
                                "config-renderer.js",
                                "start-electron.js",
                                "package.json"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  ".bundle/api",
                                             "to":  "api"
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  true,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  false,
                               "runAfterFinish":  true
                           }
              }
}
