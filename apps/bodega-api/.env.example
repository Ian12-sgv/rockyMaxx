# Bodega de datos historica - configuracion del proceso central (VPS unico).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/bodega_datos?schema=public"
PORT=3100
HOST=0.0.0.0

# Token compartido que cada tienda envia como "Authorization: Bearer <token>"
# en POST /bodega/ingest/:codigoTienda. Debe coincidir con INGEST_AUTH_TOKEN
# configurado en cada apps/api/.env.tiendaXXX.
INGEST_AUTH_TOKEN="CHANGE_ME"

# Usuarios del panel web (ClienteALI). Cada entrada: usuario|GRUPO|salt.hash
# GRUPO = TODOS (ve todo y edita Balance) o B (solo tiendas "rocky", Balance
# solo lectura). Varias entradas separadas por ";". Generar cada entrada con:
#   npm run hash-password -- <usuario> <TODOS|B>
# (nunca poner contrasenas en texto plano aqui).
PANEL_USUARIOS=""

# Opcional: secreto para firmar las sesiones del panel (12 h). Si se deja
# vacio se deriva de INGEST_AUTH_TOKEN. Cambiarlo cierra todas las sesiones.
PANEL_SESSION_SECRET=""
