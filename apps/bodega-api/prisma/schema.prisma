// Bodega de datos historica multi-tienda (MVP).
// Base fisica dedicada: bodega_datos (VPS). No comparte conexion con apps/api.
// Nomenclatura obligatoria: DIM_* dimensiones, HECH_* hechos, ETL_* control de sync.

generator client {
  provider = "prisma-client-js"
  // Output aislado: este workspace NUNCA debe escribir en node_modules/@prisma/client
  // (esa ruta la hospeda el workspace npm en la raiz y ya la usa apps/api con un
  // schema completamente distinto; generar ahi sin output propio lo sobrescribe).
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DimTiendas {
  id           String   @id @default(uuid()) @db.Uuid
  codigoLegacy String   @unique(map: "uq_dim_tiendas_codigo_legacy") @map("codigo_legacy") @db.VarChar(20)
  tipo         String   @map("tipo") @db.VarChar(20)
  nombre       String?  @map("nombre") @db.VarChar(120)
  databaseName String?  @map("database_name") @db.VarChar(120)
  apiPath      String?  @map("api_path") @db.VarChar(120)
  activa       Boolean  @default(true) @map("activa")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  articulosHist     DimArticulosHist[]
  clientesHist      DimClientesHist[]
  inventarioHist    HechInventarioHist[]
  ventasHist        HechVentasHist[]
  ventasDetalleHist HechVentasDetalleHist[]
  pagosHist         HechPagosHist[]
  cajasHist         HechCajasHist[]
  syncRuns          EtlSyncRuns[]
  syncErrors        EtlSyncErrors[]
  watermarks        EtlWatermarks[]
  balanceMovimientos BalanceMovimientoTienda[]

  @@map("DIM_TIENDAS")
}

model DimArticulosHist {
  id                 String    @id @default(uuid()) @db.Uuid
  dimTiendaId        String    @map("dim_tienda_id") @db.Uuid
  codigoTiendaLegacy String    @map("codigo_tienda_legacy") @db.VarChar(20)
  tablaOrigen        String    @map("tabla_origen") @db.VarChar(60)
  pkOrigen           String    @map("pk_origen") @db.VarChar(200)
  operacion          String    @map("operacion") @db.VarChar(20)
  hashRegistro       String    @map("hash_registro") @db.VarChar(64)
  payloadJson        Json      @map("payload_json")
  esActual           Boolean   @default(true) @map("es_actual")
  validoDesde        DateTime  @default(now()) @map("valido_desde")
  validoHasta        DateTime? @map("valido_hasta")
  syncRunId          String    @map("sync_run_id") @db.Uuid
  fechaExtraida      DateTime  @map("fecha_extraida")
  fechaCargada       DateTime  @default(now()) @map("fecha_cargada")

  dimTienda DimTiendas  @relation(fields: [dimTiendaId], references: [id])
  syncRun   EtlSyncRuns @relation(fields: [syncRunId], references: [id])

  @@unique([dimTiendaId, tablaOrigen, pkOrigen, hashRegistro], map: "uq_dim_articulos_hist_identidad")
  @@index([dimTiendaId, tablaOrigen, pkOrigen, esActual], map: "ix_dim_articulos_hist_actual")
  @@map("DIM_ARTICULOS_HIST")
}

