model EtlSyncRuns {
  id                    String    @id @default(uuid()) @db.Uuid
  dimTiendaId           String    @map("dim_tienda_id") @db.Uuid
  codigoTiendaLegacy    String    @map("codigo_tienda_legacy") @db.VarChar(20)
  startedAt             DateTime  @default(now()) @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  status                String    @default("RUNNING") @map("status") @db.VarChar(20)
  tablasProcesadas      Json      @default("[]") @map("tablas_procesadas")
  registrosLeidos       Int       @default(0) @map("registros_leidos")
  registrosInsertados   Int       @default(0) @map("registros_insertados")
  registrosActualizados Int       @default(0) @map("registros_actualizados")
  registrosOmitidos     Int       @default(0) @map("registros_omitidos")
  errorCount            Int       @default(0) @map("error_count")

  dimTienda DimTiendas @relation(fields: [dimTiendaId], references: [id])

  articulosHist     DimArticulosHist[]
  clientesHist      DimClientesHist[]
  inventarioHist    HechInventarioHist[]
  ventasHist        HechVentasHist[]
  ventasDetalleHist HechVentasDetalleHist[]
  pagosHist         HechPagosHist[]
  cajasHist         HechCajasHist[]
  errores           EtlSyncErrors[]

  @@index([dimTiendaId, startedAt], map: "ix_etl_sync_runs_tienda_started")
  @@map("ETL_SYNC_RUNS")
}

model EtlSyncErrors {
  id                 String   @id @default(uuid()) @db.Uuid
  syncRunId          String   @map("sync_run_id") @db.Uuid
  dimTiendaId        String   @map("dim_tienda_id") @db.Uuid
  codigoTiendaLegacy String   @map("codigo_tienda_legacy") @db.VarChar(20)
  tablaOrigen        String   @map("tabla_origen") @db.VarChar(60)
  pkOrigen           String?  @map("pk_origen") @db.VarChar(200)
  errorMessage       String   @map("error_message") @db.Text
  payloadJson        Json?    @map("payload_json")
  createdAt          DateTime @default(now()) @map("created_at")

  syncRun   EtlSyncRuns @relation(fields: [syncRunId], references: [id])
  dimTienda DimTiendas  @relation(fields: [dimTiendaId], references: [id])

  @@index([dimTiendaId, tablaOrigen, createdAt], map: "ix_etl_sync_errors_tienda_tabla")
  @@index([syncRunId], map: "ix_etl_sync_errors_run")
  @@map("ETL_SYNC_ERRORS")
}

model EtlWatermarks {
  id                 String    @id @default(uuid()) @db.Uuid
  dimTiendaId        String    @map("dim_tienda_id") @db.Uuid
  codigoTiendaLegacy String    @map("codigo_tienda_legacy") @db.VarChar(20)
  entidadDestino     String    @map("entidad_destino") @db.VarChar(60)
  tablaOrigen        String    @map("tabla_origen") @db.VarChar(60)
  lastPkOrigen       String?   @map("last_pk_origen") @db.VarChar(200)
  lastUpdatedAt      DateTime? @map("last_updated_at")
  lastHash           String?   @map("last_hash") @db.VarChar(64)
  updatedAt          DateTime  @updatedAt @map("updated_at")

  dimTienda DimTiendas @relation(fields: [dimTiendaId], references: [id])

  @@unique([dimTiendaId, entidadDestino], map: "uq_etl_watermarks_tienda_entidad")
  @@map("ETL_WATERMARKS")
}

// Ingresos/egresos registrados a mano desde el panel "Balance" -- no vienen
// de ningun ETL, los carga un usuario del panel. Vista aparte de la
// ganancia calculada de ventas-costo (no se mezclan): esto es dinero que
// entro o salio fuera del flujo normal de venta (aportes, prestamos,
// alquiler, nomina, etc.). Un mismo movimiento puede aplicar a varias
// tiendas a la vez (tabla puente BalanceMovimientoTienda) -- el monto NO
// se multiplica por tienda, es un solo monto compartido entre las tiendas
// seleccionadas.
model BalanceMovimiento {
  id            String   @id @default(uuid()) @db.Uuid
  tipo          String   @map("tipo") @db.VarChar(10) // "ingreso" | "egreso"
  esOperativo   Boolean  @default(false) @map("es_operativo")
  monto         Decimal  @map("monto") @db.Decimal(18, 2)
  descripcion   String   @map("descripcion") @db.VarChar(300)
  fecha         DateTime @map("fecha") @db.Date
  registradoPor String?  @map("registrado_por") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")

  tiendas BalanceMovimientoTienda[]

  @@index([fecha, tipo], map: "ix_balance_movimientos_fecha_tipo")
  @@map("BALANCE_MOVIMIENTOS")
}

model BalanceMovimientoTienda {
  id           String @id @default(uuid()) @db.Uuid
  movimientoId String @map("movimiento_id") @db.Uuid
  dimTiendaId  String @map("dim_tienda_id") @db.Uuid

  movimiento BalanceMovimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  dimTienda  DimTiendas        @relation(fields: [dimTiendaId], references: [id])

  @@unique([movimientoId, dimTiendaId], map: "uq_balance_mov_tienda")
  @@index([dimTiendaId], map: "ix_balance_mov_tienda_tienda")
  @@map("BALANCE_MOVIMIENTOS_TIENDAS")
}
